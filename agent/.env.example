# ─── NotherClass Agent: configuración ─────────────────────────────────────────
# Copia este archivo a ".env" y rellena. NUNCA subas tu .env a git.
# Basta con la clave de un proveedor compatible con la API de OpenAI.

# Identidad
# TW_AGENT_NAME = nombre visible (cómo te habla). TW_AGENT_STORE = clave estable
# de su BD de memoria (brain_<STORE>.sqlite3). NO cambies STORE si quieres
# conservar lo aprendido.
TW_AGENT_NAME=Joker
TW_AGENT_STORE=Forja
TW_AGENT_PERSONA=AGENTS/notherclass-joker.md
# Carpeta sobre la que el agente tiene permiso de escribir (todo notherclass):
TW_WORKSPACE=../

# ─── Capa LLM (multi-proveedor) ──────────────────────────────────────────────
# Rellena SOLO TW_LLM_API_KEY: el modelo y la URL se resuelven por proveedor.
# Modelo: deepseek-chat (estandar) | deepseek-reasoner (con razonamiento)
TW_LLM_PROVIDER=deepseek
TW_LLM_API_KEY=
TW_LLM_BASE_URL=
TW_LLM_MODEL=deepseek-chat
TW_REASONING_EFFORT=low     # low | medium | high
TW_THINKING=1               # 1 = pensamiento activado, 0 = desactivado
# otros proveedores (opcional): openrouter/openai/custom
# Defaults por proveedor:
#   deepseek  -> https://api.deepseek.com/v1/chat/completions  | deepseek-chat
#   glm       -> https://api.z.ai/api/paas/v4/chat/completions  | glm-4.7-flashx
#   openrouter-> https://openrouter.ai/api/v1/chat/completions  | <el que quieras>
#   openai    -> https://api.openai.com/v1/chat/completions     | gpt-4o-mini

# ─── Memoria (nuestra mente) ───────────────────────────────────────────────
TW_MEMORY_DIR=MEMORY
# Presupuesto de contexto por turno (memoria + archivos leídos). deepseek-v4-flash
# soporta ~1M; configurable. 262144 = 256k.
TW_CONTEXT_BUDGET_TOKENS=262144
# Nº de chunks de trabajo que SIEMPRE se incluyen (lo más reciente)
TW_WORKING_CHUNKS=6

# ─── Telegram ───────────────────────────────────────────────────────────────
# Token del bot (crear con @BotFather). Dejar vacío para usar solo --oneshot.
TW_TELEGRAM_BOT_TOKEN=
# Tu id numérico de Telegram (whitelist). Se obtiene con @userinfobot. Vacío = cualquiera.
TW_TELEGRAM_ALLOWED_USER_IDS=

# ─── Extra ──────────────────────────────────────────────────────────────────
TW_MAX_REPLY_CHARS=3200
# Muestra el pie de uso al final de cada respuesta (0=no, consulta con /uso)
TW_SHOW_USAGE_FOOTER=0

# ── FILTRO BigBoss (2º cerebro revisor, cuando Joker edita código) ─────────
TW_ENABLE_REVIEW=1
# o kimi-k2.7-code-highspeed
TW_REVIEW_MODEL=kimi-k2.7-code
TW_REVIEW_BASE_URL=https://api.moonshot.ai/v1/chat/completions
TW_REVIEW_API_KEY=sk-...
TW_REVIEW_REASONING_EFFORT=high
TW_REVIEW_THINKING=1
TW_REVIEW_MAX_ROUNDS=2
TW_REVIEW_MAX_TOKENS=20000
TW_REVIEW_MAX_FETCHES=3
# Confirmación de edición ("pausa real")
TW_CONFIRM_EDITS=1
# Techo de salida del LLM por mensaje (tokens). deepseek-v4-flash permite ~384k
# de salida; este valor es configurable (64k por defecto).
TW_AGENT_MAX_TOKENS=65536

# Log de actividad (para hacer tail con tail_agent.py)
TW_LOG_FILE=logs/agent.log

# ─── Voz local (STT + TTS, 0 tokens) ────────────────────────────────────────
# STT: faster-whisper (venv311) o whisper.cpp. Modelo whisper: se instala con la
# imagen Docker o el instalador de escritorio.
# TTS: piper. Las VOCES (.onnx, ~60 MB) NO vienen en el repo: se descargan solas
# la primera vez que el agente habla y quedan en agent/audio_models/ (en Docker,
# monta esa carpeta como volumen para no bajarlas en cada rebuild).
# TW_STT_LANG=es
# TW_PIPER_MODEL=audio_models/es_ES-davefx-medium.onnx        # voz española
# TW_PIPER_MODEL_EN=audio_models/en_US-lessac-medium.onnx     # voz inglesa (traductor)

# Consolidación (aprender de verdad: bruto→neto)
# Cada N segundos el daemon destila lo bruto con un LLM. 0 = solo manual (/consolidar)
TW_CONSOLIDATE_EVERY=0
TW_CONSOLIDATE_MIN_CHUNKS=2

