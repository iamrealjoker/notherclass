# ─────────────────────────────────────────────────────────────
#  SECRETOS — NUNCA subir
#  Las plantillas (*.example) SÍ se suben: son las que el usuario copia.
#  OJO: las excepciones (!) van AL FINAL del bloque; si van antes, la regla
#  siguiente las vuelve a excluir y el repo se publica sin plantillas.
# ─────────────────────────────────────────────────────────────
.env
.env.*
agent/.env
agent/.env.*
*.pem
*.key
credentials.json

# excepciones (¡deben ir DESPUÉS de las reglas de arriba!)
!.env.example
!.env.*.example
!*.env.example
!agent/.env.example
!agent/.env.*.example

# ─────────────────────────────────────────────────────────────
#  DATOS / MEMORIA (privados: cada usuario genera los suyos)
# ─────────────────────────────────────────────────────────────
MEMORY/
*/MEMORY/
**/memory/
*.sqlite3
*.sqlite3-*
*.db
grupo_bus/
consola/datos/
consola/certs/
translator/STATE/
Ag.*/memory/
Ag.*/logs/
logs/
**/logs/
*.log
*.out
pending_*.json

# ─────────────────────────────────────────────────────────────
#  ENTORNOS / DEPENDENCIAS / MODELOS (pesados y reproducibles)
# ─────────────────────────────────────────────────────────────
venv/
venv311/
.venv/
__pycache__/
*.pyc
audio_models/
models/

# ─────────────────────────────────────────────────────────────
#  COPIAS Y BASURA
# ─────────────────────────────────────────────────────────────
*.bak
*.bak_*
*.bak-*
*.orig
*~
.DS_Store
